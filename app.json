{
  "expo": {
    "name": "Mi Chamba",
    "slug": "mi-chamba",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Mi Chamba necesita acceder a la camara para tomar tu foto de perfil.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Mi Chamba necesita acceder a la camara para tomar tu foto de perfil."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#021B30"
      }
    }
  }
}
